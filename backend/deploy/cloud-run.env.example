APP_NAME="MD2Blog API"
ENVIRONMENT=production
LOG_LEVEL=INFO
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAMESITE=none
CORS_ALLOWED_ORIGINS=https://md2blog.pages.dev
FRONTEND_URL=https://md2blog.pages.dev
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_GMAIL_ADDRESS
EMAIL_FROM="MD2Blog <REPLACE_WITH_GMAIL_ADDRESS>"
OBJECT_STORAGE_BACKEND=r2
R2_ENDPOINT_URL=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=REPLACE_WITH_R2_BUCKET_NAME
