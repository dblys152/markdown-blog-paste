APP_NAME=MD2Blog API
ENVIRONMENT=local
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_GMAIL_ADDRESS
SMTP_PASSWORD=REPLACE_WITH_GOOGLE_APP_PASSWORD
EMAIL_FROM="MD2Blog <REPLACE_WITH_GMAIL_ADDRESS>"
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_DAILY_LIMIT=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_DAILY_LIMIT=5
